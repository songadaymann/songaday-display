# Copy to .env for local scripts (paths only; they are not secrets).
# Keep real credentials OUTSIDE Dropbox-synced folders: put them in ~/.config/songaday-display/.env,
# which the pipeline also reads. Worker secrets go in via `wrangler secret put`. Never VITE_-prefix a secret.

# Local working files: cells, tiles, upload queue (~1 GB). Keep it out of Dropbox.
# SONGADAY_DISPLAY_CACHE_DIR=~/Library/Caches/songaday-display

# Song A Day sources
# SONGADAY_ARCHIVE_DIR=          # "Every Single Song A Day Ever" (EverySongADayPNG/, Every Song A Day Gif/, Every Song A Day Video/)
# SONGADAY_TOOLKIT_DIR=          # songaday-toolkit checkout
# SONGADAY_TOOLKIT_OUTPUT_DIR=   # the checkout's output/<n>/ (art, videos, metadata.json); defaults to $SONGADAY_TOOLKIT_DIR/output
# SONGADAY_OUTPUT_DIR=           # where the toolkit's daily run writes output/<n>/initial-metadata.json (the toolkit's own SONGADAY_OUTPUT_DIR)
# SONGADAY_LEGACY_MASTER=        # old gallery's full-resolution mosaic, level_7_master.jpg (songs 1-5852)
# SONGADAY_LEGACY_JSONL=         # old gallery's songaday_clean.jsonl (descriptions for 1-5845)
# FFMPEG=ffmpeg                  # optional; found on PATH by default
# FFPROBE=ffprobe

# Archive audit, online mode only (npm run archive:audit -- --online)
# SONGADAY_IPFS_GATEWAY=https://songaday.mypinata.cloud
# SONGADAY_AUDIO_BASE_URL=https://songaday.fan/api/audio

# Public client config (ends up in the browser bundle - not secret).
# Unset: /media in dev (served from the cache), https://tiles.songaday.world in a build.
# VITE_MEDIA_BASE=

# Uploads to R2 (npm run r2:sync). A token with Object Read & Write on the two buckets only; keep it
# in ~/.config/songaday-display/.env. Without it, r2:sync falls back to `wrangler login` (slower).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional, for a fork with its own buckets and host:
# R2_MEDIA_BUCKET=songaday-display-media        # public, behind the custom domain below
# R2_ARCHIVE_BUCKET=songaday-display-archive    # private: lossless cell masters
# SONGADAY_MEDIA_PUBLIC=https://tiles.songaday.world

# Worker secrets (wrangler secret put; .dev.vars for local wrangler dev). See worker/README.md.
# OPENSEA_API_KEY=
# MAINNET_RPC_URL=
